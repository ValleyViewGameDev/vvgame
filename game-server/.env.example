# Names only; values live in game-server/.env (never committed). See CLAUDE.md.
MONGODB_URI=
SECRET_KEY=
STRIPE_SECRET_KEY=
YOUR_DOMAIN=https://www.secretsofelsinore.com
# Owner alert on every named new account (utils/emailUtils.js, Gmail + app password)
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECEIVER=valleyviewgamedev@gmail.com
# Loops transactional email (docs/onboarding-plan.md §4.6). Templates are authored in the Loops
# dashboard; each var is a template id, one per email + language (EN is the fallback). With
# LOOPS_API_KEY unset every send is skipped (logged, never blocking).
LOOPS_API_KEY=
LOOPS_TID_WELCOME_EN=
LOOPS_TID_WELCOME_ES=
LOOPS_TID_WELCOME_FR=
LOOPS_TID_WELCOME_DE=
LOOPS_TID_EVENT_EN=
LOOPS_TID_EVENT_ES=
LOOPS_TID_EVENT_FR=
LOOPS_TID_EVENT_DE=
# Public base URL of this server for links built into emails (unsubscribe)
PUBLIC_SERVER_URL=https://vvgame-server.onrender.com
# Salt for the signup IP hash (falls back to SECRET_KEY)
SIGNUP_IP_SALT=
