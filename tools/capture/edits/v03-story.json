  "captions": [
    {
      "segment": 0,
      "text": "A storm tore every story apart."
    },
    {
      "segment": 1,
      "who": "Gertrude",
      "size": 62,
      "text": "“I was stone so long, I almost forgot the feel of the sun.”"
    },
    {
      "segment": 2,
      "toSegment": 3,
      "who": "Leontes",
      "size": 62,
      "text": "“The storm turned my Queen to stone and stole my crown.”"
    },
    {
      "segment": 4,
      "who": "Titania",
      "size": 62,
      "text": "“Prospero was my friend before his storm, and now I fear him.”"
    },
    {
      "segment": 6,
      "toSegment": 7,
      "text": "Take up their quests."
    },
    {
      "segment": 8,
      "text": "And the magician?"
    },
    {
      "segment": 9,
      "who": "Prospero",
      "size": 62,
      "text": "“I raised the storm, and I have repented it every day since.”"
    }
  ],
  "endCard": {
